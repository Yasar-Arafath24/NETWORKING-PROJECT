# Set this to the Web application OAuth client ID from Google Cloud Console.
# The same backend value is returned to the frontend by /api/v1/auth/google/config.
GOOGLE_CLIENT_ID=

# Supabase session-pooler connection string from Supabase -> Database -> Connect.
# Keep it backend-only; the pooler username must include your project reference.
NETSENTRY_DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-URL-ENCODED-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres?sslmode=require

NETSENTRY_COOKIE_SECURE=false
NETSENTRY_COOKIE_SAMESITE=lax
NETSENTRY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Canonical public backend origin used in customer agent ZIP files.
# Required in production and must use HTTPS. Leave unset for local development.
NETSENTRY_PUBLIC_API_URL=

# Email signup verification and password recovery. Keep these values in the
# backend .env only. Use the SMTP login and SMTP key from Brevo, and a sender
# address verified in your Brevo account.
NETSENTRY_ENV=development
NETSENTRY_EMAIL_DELIVERY=smtp
NETSENTRY_OTP_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_username
MAIL_PASSWORD=your_brevo_smtp_key_here
MAIL_FROM=your_verified_brevo_email@example.com
MAIL_FROM_NAME=NetSentry AI
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Website telemetry anomaly rule thresholds. Configure to match each site's traffic.
NETSENTRY_WEBSITE_SOURCE_RPM=60
NETSENTRY_WEBSITE_SITE_RPM=120
NETSENTRY_WEBSITE_ENDPOINT_RPM=40
NETSENTRY_WEBSITE_SCAN_PATHS=3
NETSENTRY_WEBSITE_LOGIN_FAILURES=5
NETSENTRY_WEBSITE_ERROR_BURST=10
NETSENTRY_WEBSITE_SLOW_MS=5000
NETSENTRY_WEBSITE_SLOW_REPEAT=3
NETSENTRY_WEBSITE_RATE_SURGE_RATIO=4
NETSENTRY_WEBSITE_RATE_SURGE_MINIMUM=20
NETSENTRY_WEBSITE_REPEATED_UA=20
NETSENTRY_WEBSITE_ALERT_MINIMUM_SCORE=20
NETSENTRY_WEBSITE_CONNECTED_SECONDS=120
# Optional comma-separated additions/replacements and endpoint method policy JSON.
NETSENTRY_SENSITIVE_PATHS=/.env,/.git/config,/config.php,/backup.zip,/database.sql,/admin,/wp-admin,/wp-login.php,/xmlrpc.php,/phpmyadmin,/server-status,/etc/passwd,/actuator/env,/cgi-bin/
NETSENTRY_SCANNER_USER_AGENTS=sqlmap,nikto,nmap,masscan,zgrab,acunetix,nessus
NETSENTRY_WEBSITE_METHOD_POLICIES={}
# Optional category-specific weights, e.g. NETSENTRY_RISK_WEIGHT_SENSITIVE_PATH=60.