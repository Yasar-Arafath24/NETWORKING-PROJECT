# ============================================================
# NetSentry AI - Environment Configuration Example
# ============================================================
# Copy this file to .env and configure your actual credentials.
# NEVER upload .env to GitHub.
# ============================================================

APP_NAME=NetSentry AI
APP_VERSION=1.0.0
DEBUG=False

# ------------------------------------------------------------
# API CONFIGURATION
# ------------------------------------------------------------

API_V1_PREFIX=/api/v1

# ------------------------------------------------------------
# GOOGLE OAUTH
# ------------------------------------------------------------

GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------

# Supabase Session Pooler connection string.
# Replace all placeholders with your actual Supabase details.
# URL-encode special characters in your database password.

NETSENTRY_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend only. Never expose this key in frontend code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------
# SECURITY AND AUTHENTICATION
# ------------------------------------------------------------

SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

NETSENTRY_COOKIE_SECURE=false
NETSENTRY_COOKIE_SAMESITE=lax

# ------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------

NETSENTRY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------
# PUBLIC API URL
# ------------------------------------------------------------

# Leave empty for local development.
# Production must use your public HTTPS backend URL.

NETSENTRY_PUBLIC_API_URL=

# ------------------------------------------------------------
# EMAIL CONFIGURATION - BREVO SMTP
# ------------------------------------------------------------

NETSENTRY_ENV=development
NETSENTRY_EMAIL_DELIVERY=smtp

# Generate a secure random OTP secret.
NETSENTRY_OTP_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587

# Obtain these from your Brevo SMTP settings.
MAIL_USERNAME=YOUR_BREVO_SMTP_USERNAME
MAIL_PASSWORD=YOUR_BREVO_SMTP_KEY_HERE

# Must be a verified sender address in Brevo.
MAIL_FROM=YOUR_VERIFIED_EMAIL@example.com
MAIL_FROM_NAME=NetSentry AI

MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ------------------------------------------------------------
# WEBSITE TRAFFIC ANOMALY DETECTION
# ------------------------------------------------------------

NETSENTRY_WEBSITE_SOURCE_RPM=60
NETSENTRY_WEBSITE_SITE_RPM=120
NETSENTRY_WEBSITE_ENDPOINT_RPM=40

NETSENTRY_WEBSITE_SCAN_PATHS=3
NETSENTRY_WEBSITE_LOGIN_FAILURES=5
NETSENTRY_WEBSITE_ERROR_BURST=10

NETSENTRY_WEBSITE_SLOW_MS=5000
NETSENTRY_WEBSITE_SLOW_REPEAT=3

NETSENTRY_WEBSITE_RATE_SURGE_RATIO=4
NETSENTRY_WEBSITE_RATE_SURGE_MINIMUM=20

NETSENTRY_WEBSITE_REPEATED_UA=20
NETSENTRY_WEBSITE_ALERT_MINIMUM_SCORE=20
NETSENTRY_WEBSITE_CONNECTED_SECONDS=120

# ------------------------------------------------------------
# SENSITIVE PATH DETECTION
# ------------------------------------------------------------

NETSENTRY_SENSITIVE_PATHS=/.env,/.git/config,/config.php,/backup.zip,/database.sql,/admin,/wp-admin,/wp-login.php,/xmlrpc.php,/phpmyadmin,/server-status,/etc/passwd,/actuator/env,/cgi-bin/

# ------------------------------------------------------------
# SUSPICIOUS USER AGENT DETECTION
# ------------------------------------------------------------

NETSENTRY_SCANNER_USER_AGENTS=sqlmap,nikto,nmap,masscan,zgrab,acunetix,nessus

# ------------------------------------------------------------
# HTTP METHOD POLICIES
# ------------------------------------------------------------

NETSENTRY_WEBSITE_METHOD_POLICIES={}

# ------------------------------------------------------------
# OPTIONAL RISK WEIGHTS
# ------------------------------------------------------------

# Example:
# NETSENTRY_RISK_WEIGHT_SENSITIVE_PATH=60