# ==========================================
# NetSentry AI - Git Ignore
# ==========================================

# ------------------------------------------
# Python virtual environments
# ------------------------------------------
venv/
.venv/
env/
ENV/

# ------------------------------------------
# Python cache and compiled files
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ------------------------------------------
# Python testing and tooling
# ------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pytype/
.hypothesis/

# ------------------------------------------
# Jupyter
# ------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------
# Environment variables and secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# ------------------------------------------
# Network captures
# ------------------------------------------
*.pcap
*.pcapng
*.cap

# Keep the small, synthetic sample captures that ship with the project
!datasets/samples/*.pcap
!frontend/public/samples/*.pcap

# ------------------------------------------
# Generated datasets
# ------------------------------------------
datasets/raw/*
datasets/processed/*

# Keep dataset directories in Git
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep

# ------------------------------------------
# Generated machine-learning artifacts
# ------------------------------------------
*.pkl
*.pickle
*.joblib
*.onnx
*.h5
*.pt
*.pth

# Keep model directory if needed
!models/.gitkeep

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
logs/

# ------------------------------------------
# Temporary files
# ------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*~

# ------------------------------------------
# Python build and distribution
# ------------------------------------------
build/
dist/
*.egg-info/
wheels/
pip-wheel-metadata/

# ------------------------------------------
# Node.js and frontend dependencies
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build output
frontend/dist/
frontend/build/
frontend/.next/
frontend/.vite/
frontend/coverage/

# Local package manager files
.npm/
.eslintcache

# ------------------------------------------
# IDEs and editors
# ------------------------------------------
.vscode/
!.vscode/settings.example.json
.idea/
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# Operating system files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------
# Databases
# ------------------------------------------
*.db
*.sqlite
*.sqlite3

# ------------------------------------------
# Generated reports and exports
# ------------------------------------------
reports/generated/
exports/

# ------------------------------------------
# Temporary uploads
# ------------------------------------------
uploads/

# ------------------------------------------
# Local configuration and runtime files
# ------------------------------------------
*.pid
*.seed
*.stackdump
