# Optional API origin used by the frontend. Leave blank for the Vite /api/v1 proxy.
VITE_API_BASE_URL=

# API URL placed into commands for collector hosts (not the frontend dashboard URL).
# Set this to the public HTTPS backend origin when API and frontend are hosted separately.
# Example: VITE_COLLECTOR_API_URL=https://api.example.com
# In local Vite development, the default is http://127.0.0.1:8000.
VITE_COLLECTOR_API_URL=
